# MongoDB (same cluster the pipeline writes to; a read-write web user is fine,
# a separate `pcps-web` user is better)
MONGODB_URI=mongodb+srv://pcps-web:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
PCPS_DB=pcps

# Auth.js -- any 32+ char random string
AUTH_SECRET=

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps)
# callback URL: https://<your-app>.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated list of email addresses allowed to sign in.
# NOTE: the workbench is single-user by design (docs/ARCHITECTURE.md §9) --
# watchlist, notes, actions and settings are one shared workspace. List only
# your own addresses here; every allowed login shares the same state.
ALLOWED_EMAILS=you@example.com

# Local development only: skip auth entirely (never set in production)
# AUTH_DISABLED=1
